{
  "name": "lista-domestica",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22", "pnpm": ">=10" },
  "scripts": {
    "dev": "pnpm --parallel --filter @lista/web --filter @lista/api dev",
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @lista/api db:generate",
    "db:migrate": "pnpm --filter @lista/api db:migrate",
    "db:seed": "pnpm --filter @lista/api db:seed"
  }
}
